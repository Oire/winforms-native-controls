<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0-windows: the current LTS, supported to November 2028, and what every
             application that would consume this already targets. .NET 8 leaves support in
             November 2026 and .NET 9 already has, so targeting 8 would buy reach that does not
             exist while keeping the library off newer APIs. Plain net10.0-windows rather than a
             version-pinned net10.0-windows10.0.x, so consumers are not forced onto a minimum
             Windows SDK. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- AnyCPU: a library must not force a bitness on its consumers. The interop uses
             nint/nuint rather than fixed-width casts, so it is correct on x86, x64 and Arm64. -->
        <PlatformTarget>AnyCPU</PlatformTarget>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Oire.WinForms.NativeControls</RootNamespace>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <!-- Hold the shipping library to the same bar as the tests: warnings are build errors.
             Scoped to CI as the warning-clean source of truth (full history, github.com remote);
             local builds may surface environment-specific warnings we don't want to hard-fail on. -->
        <TreatWarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <!-- Ship XML docs, and unlike sibling Oire libraries, require them on every public member.
             The public surface here is small, already fully documented, and is the whole product -
             an undocumented member on a menu API is a defect, not a style preference. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Reproducible build + source debugging -->
        <Deterministic>true</Deterministic>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <!-- SourceLink resolves source-file URLs from the git remote. Off CI the remote may be an SSH
             host alias (e.g. "github:") that SourceLink's GitHub provider doesn't recognize, so it can't
             build the link and emits a benign "source control information is not available" warning.
             SourceLink only matters for the published package (built in CI with a github.com remote and
             full history), so turn it off off CI to keep developer builds warning-clean. -->
        <EnableSourceLink Condition="'$(GITHUB_ACTIONS)' != 'true'">false</EnableSourceLink>

        <!-- Package metadata. Version comes from GitVersion (ManualDeployment): a `v*` tag sets it. -->
        <Product>Oire WinForms Native Controls</Product>
        <Description>Win32-native replacements for the Windows Forms controls that screen readers handle poorly. Menu bars and context menus built on real HMENU handles instead of WinForms' managed ToolStrip, announced as menu bars, submenus and popup menus, with mnemonic-collision validation and a proper accelerator table. Plus a ListView that screen readers can read past the first column, which the stock control's UI Automation provider prevents. Toolbars and status bars are the intended next members.</Description>
        <Authors>André Polykanine, Oire Software</Authors>
        <Company>Oire Software</Company>
        <Copyright>Copyright © 2026 André Polykanine, Oire Software, and contributors.</Copyright>
        <PackageId>Oire.WinForms.NativeControls</PackageId>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Oire/winforms-native-controls</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Oire/winforms-native-controls</PackageProjectUrl>
        <PackageTags>winforms;accessibility;a11y;screen-reader;win32;pinvoke;hmenu;menu;listview;jaws;nvda</PackageTags>
        <PackageReadmeFile>docs/README.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/Oire/winforms-native-controls/blob/master/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <!-- The tests exercise internal seams: the id-to-callback routing behind TryRoute, the
             allocated command ids, and the popup-tracking flag. None of that belongs in the
             public API just to be testable. -->
        <InternalsVisibleTo Include="Oire.WinForms.NativeControls.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="docs" />
        <None Include="../../CHANGELOG.md" Pack="true" Visible="false" PackagePath="docs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
