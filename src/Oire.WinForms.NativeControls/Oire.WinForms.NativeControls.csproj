<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0-windows: the current LTS, supported to November 2028, and what every
             application that would consume this already targets. .NET 8 leaves support in
             November 2026 and .NET 9 already has, so targeting 8 would buy reach that does not
             exist while keeping the library off newer APIs. Plain net10.0-windows rather than a
             version-pinned net10.0-windows10.0.x, so consumers are not forced onto a minimum
             Windows SDK. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- AnyCPU: a library must not force a bitness on its consumers. The interop is written
             in terms of IntPtr, which is pointer-sized by definition, so it is correct on x86,
             x64 and Arm64 alike. -->
        <PlatformTarget>AnyCPU</PlatformTarget>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Oire.WinForms.NativeControls</RootNamespace>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <!-- Hold the shipping library to the same bar as the tests: warnings are build errors.
             Scoped to CI as the warning-clean source of truth (full history, github.com remote);
             local builds may surface environment-specific warnings we don't want to hard-fail on. -->
        <TreatWarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <!-- Ship XML docs, and unlike sibling Oire libraries, require them on every public member.
             The public surface here is small, already fully documented, and is the whole product -
             an undocumented member on a menu API is a defect, not a style preference. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Reproducible build + source debugging -->
        <Deterministic>true</Deterministic>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <!-- SourceLink resolves source-file URLs from the git remote. Off CI the remote may be an SSH
             host alias (e.g. "github:") that SourceLink's GitHub provider doesn't recognize, so it can't
             build the link and emits a benign "source control information is not available" warning.
             SourceLink only matters for the published package (built in CI with a github.com remote and
             full history), so turn it off off CI to keep developer builds warning-clean. -->
        <EnableSourceLink Condition="'$(GITHUB_ACTIONS)' != 'true'">false</EnableSourceLink>

        <!-- Package metadata. Version comes from GitVersion (ManualDeployment): a `v*` tag sets it. -->
        <Product>Oire WinForms Native Controls</Product>
        <Description>Win32-native replacements for the Windows Forms controls that screen readers handle poorly. Menu bars and context menus built on real HMENU handles instead of WinForms' managed ToolStrip, announced as menu bars, submenus and popup menus, with mnemonic-collision validation and a proper accelerator table. Plus a ListView that screen readers can read past the first column, which the stock control's UI Automation provider prevents.</Description>
        <Authors>André Polykanine, Oire Software</Authors>
        <Company>Oire Software</Company>
        <Copyright>Copyright © 2026 André Polykanine, Oire Software, and contributors.</Copyright>
        <PackageId>Oire.WinForms.NativeControls</PackageId>
        <!-- nuget.org shows the id when there is no title, which reads as a namespace rather
             than a name. -->
        <Title>Oire WinForms Native Controls</Title>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/Oire/winforms-native-controls</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Oire/winforms-native-controls</PackageProjectUrl>
        <PackageTags>winforms;accessibility;a11y;screen-reader;win32;pinvoke;hmenu;menu;listview;jaws;nvda</PackageTags>
        <PackageReadmeFile>docs/README.md</PackageReadmeFile>
        <PackageReleaseNotes>Release notes for every version are in CHANGELOG.md, shipped in this package under docs/ and published at https://github.com/Oire/winforms-native-controls/blob/master/CHANGELOG.md</PackageReleaseNotes>

        <!-- Compare every pack against the last published stable package and fail on a breaking
             change to the public surface, which is what makes the semantic-versioning promise in
             the README something the build enforces rather than something we remember.

             OFF until 1.0.0 is on nuget.org, and deliberately so: the promise starts at 1.0, and
             a baseline before then would lock in 0.x decisions at the one moment they are still
             open to revision. The baseline also has to name a package that already exists on a
             feed, so it cannot point at 1.0.0 in advance.

             TO ENABLE, in the first change after 1.0.0 is published:
               <EnablePackageValidation>true</EnablePackageValidation>
               <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
             Thereafter bump the baseline to the newest published version whenever a deliberate
             breaking change ships in a new major. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <!-- The tests exercise internal seams: the id-to-callback routing behind TryRoute, the
             allocated command ids, and the popup-tracking flag. None of that belongs in the
             public API just to be testable. -->
        <InternalsVisibleTo Include="Oire.WinForms.NativeControls.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="docs" />
        <None Include="../../CHANGELOG.md" Pack="true" Visible="false" PackagePath="docs" />
        <!-- PackagePath is the package root: PackageIcon above names it without a folder. -->
        <None Include="../../icon.png" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
